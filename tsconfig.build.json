{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "${configDir}/src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  }
}
